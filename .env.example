# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLUTTERWAVE PRODUCTION PAYMENT INTEGRATION:
# Frontend Public Key (Flutterwave Client ID):
VITE_FLUTTERWAVE_CLIENT_ID=
VITE_FLW_PUBLIC_KEY=
# Server Backend Secrets ONLY (Never prefix with VITE_):
FLUTTERWAVE_CLIENT_SECRET=
ENCRYPTION_KEY=
FLW_VERIFY_HASH=
FLUTTERWAVE_ENCRYPTION_KEY=

# PAYPAL HOSTED BUTTON & CLIENT CONFIGURATION:
# Enter your PayPal SDK Client ID and your Hosted Button ID.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_HOSTED_BUTTON_ID=

# PAYSTACK PAYMENT INTEGRATION:
# Enter your Paystack Public Key (for frontend) and Secret Key (for secure backend signature verification)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

