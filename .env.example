# EFADO Server Environment Configuration
PORT=3000
NODE_ENV=production

# Security & Data Encryption
ENCRYPTION_KEY=your_base64_32_byte_aes_gcm_key_here

# Payment Gateway Secrets (Server-side ONLY - Never expose to client)
OPAY_SECRET_KEY=OPAYPRV_mock_secret_key_server_only
PAYSTACK_SECRET_KEY=sk_live_mock_secret_key_server_only
FLUTTERWAVE_CLIENT_SECRET=mock_flw_client_secret_server_only
FLW_SECRET_KEY=FLWSECK_mock_secret_key_server_only
NEXT_PUBLIC_BASE_URL=https://your-frontend-domain.com

# Third-party Integrations (Server-side proxies)
AGORA_APP_ID=mock_agora_app_id
AGORA_APP_CERTIFICATE=mock_agora_server_certificate
TENOR_API_KEY=mock_tenor_api_key_server_only

# AWS S3 Cloud Storage (Server-side signed URLs only)
AWS_ACCESS_KEY_ID=mock_aws_access_key_id
AWS_SECRET_ACCESS_KEY=mock_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=efado-media-vault

# Database / Firestore
FIRESTORE_PROJECT_ID=efado-hubs-cloud
