rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'efado226@gmail.com' ||
        request.auth.token.email == 'efadofestus@gmail.com' ||
        request.auth.token.email == 'festdanemh@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Public or semi-public system feeds
    match /adminStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // User profiles & auth
    match /users/{userId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write: if true;
    }

    match /deposits/{depId} {
      allow read, write: if true;
    }

    match /withdrawals/{wId} {
      allow read, write: if isAuthenticated();
    }

    match /vtu_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated();
    }

    // Marketplace, listings, products, & orders
    match /ad_listings/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /advert_categories/{catSlug} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasAll(['slug', 'name', 'submissionCount', 'promoted'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.submissionCount is number
        && request.resource.data.promoted is bool;
      allow delete: if isAdmin();
    }

    match /advert_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['adId', 'userId', 'userName', 'text'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /ads/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /marketProducts/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /market_orders/{id} {
      allow read, write: if isAuthenticated();
    }

    match /vendors/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Media, reels, & social
    match /reels/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /social_posts/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gist_live_rooms/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gist_communities/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gist_groups/{id} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.name is string;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /gist_chat_messages/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    match /nexus_stories/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /nexus_pages/{id} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /nexus_moments/{id} {
      allow read: if resource.data.status != 'archived' || (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /nexus_assembly_messages/{id} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /nexus_mind_pro_entries/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /nexus_mind_pro_sessions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // HepiHands Loans
    match /loans/{id} {
      allow read, write: if isAuthenticated();
    }

    match /loan_applications/{id} {
      allow read, write: if isAuthenticated();
    }

    match /loan_vendors/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Efadoworks Freelancing
    match /efado_jobs/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /efado_freelancers/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /efado_clients/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /efado_notifications/{id} {
      allow read, write: if isAuthenticated();
    }

    match /efado_bids/{id} {
      allow read, write: if isAuthenticated();
    }

    match /efado_contracts/{id} {
      allow read, write: if isAuthenticated();
    }

    match /efado_milestones/{id} {
      allow read, write: if isAuthenticated();
    }

    // 15 Hubs Collections
    match /gamingPlays/{id} { allow read, write: if isAuthenticated(); }
    match /brandNames/{id} { allow read, write: if isAuthenticated(); }
    match /serviceRequests/{id} { allow read, write: if isAuthenticated(); }
    match /service_requests/{id} { allow read, write: if isAuthenticated(); }
    match /service_providers/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /jobPosts/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /communityPosts/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /loanApplications/{id} { allow read, write: if isAuthenticated(); }
    match /domains/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /domain_sellers/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /domain_orders/{id} { allow read, write: if isAuthenticated(); }
    match /sourcingOrders/{id} { allow read, write: if isAuthenticated(); }
    match /sourcing_requests/{id} { allow read, write: if isAuthenticated(); }
    match /cryptoOrders/{id} { allow read, write: if isAuthenticated(); }
    match /crypto_conversions/{id} { allow read, write: if isAuthenticated(); }
    match /partnerEarnings/{id} { allow read, write: if isAuthenticated(); }
    match /partner_applications/{id} { allow read, write: if isAuthenticated(); }
    match /houseListings/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /cargoShipments/{id} { allow read, write: if isAuthenticated(); }
    match /help_requests/{id} { allow read, write: if isAuthenticated(); }
    match /help_inbox/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll(['userName', 'hub', 'subject', 'message', 'status'])
                    && request.resource.data.status == 'New'
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.userName.size() <= 120
                    && request.resource.data.hub is string
                    && request.resource.data.hub.size() > 0
                    && request.resource.data.hub.size() <= 120
                    && request.resource.data.subject in ['Payment Issue', 'Game Issue', 'Withdrawal', 'Account', 'Other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 3000;
      allow update: if isAdmin() && request.resource.data.status in ['New', 'Replied', 'Closed'];
      allow delete: if isAdmin();
    }
    match /manual_game_pins/{id} { allow read, write: if isAuthenticated(); }
    match /admin_logs/{id} { allow read, write: if isAdmin(); }
    match /cscc_groups/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /quiz_sessions/{id} { allow read, write: if isAuthenticated(); }
    match /email_accounts/{id} { allow read, write: if isAuthenticated(); }
    match /incubator_ideas/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /live_classes/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /creator_stats/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /wallets/{id} { allow read, write: if true; }
    match /wallets/{walletId}/{document=**} { allow read, write: if true; }
    match /pendingPayments/{paymentId} { allow read, write: if true; }
    match /vending_purchases/{id} { allow read, write: if isAuthenticated(); }
    match /zoom_subscriptions/{id} { allow read, write: if isAuthenticated(); }
    match /jamb_candidates/{id} { allow read, write: if isAuthenticated(); }
    match /waec_scratch_cards/{id} { allow read, write: if isAuthenticated(); }

    // Fallback safe catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
